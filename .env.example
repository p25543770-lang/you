# Пример настроек. Скопировать в .env и заполнить своими значениями.
# Файл .env в git не попадает (см. .gitignore).

# Ключ подписи cookie-сессии. ОБЯЗАТЕЛЕН в бою.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RC_SECRET_KEY=

# Файл с учётками операторов (создаётся скриптом scripts/create_operator.py)
RC_OPERATORS_FILE=data/operators.json

# Сетевые параметры веб-интерфейса
RC_BIND_HOST=0.0.0.0
RC_PORT=8080

# Обновление из Git remote: по кнопке в операторской панели.
# Ветка по умолчанию — текущая Git-ветка; задайте RC_UPDATE_BRANCH=main,
# если нужно следить за main. Грязная рабочая копия не обновляется.
RC_UPDATE_REMOTE=origin
RC_UPDATE_BRANCH=

# true, если страница отдаётся по HTTPS (тогда cookie помечается Secure)
RC_COOKIE_SECURE=false

# SameSite для cookie сессии: Lax (по умолчанию), Strict или None.
# None нужен, когда пульт открыт во встроенном cross-site предпросмотре (iframe) —
# в этом случае приложение автоматически включает и Secure.
# Для реальной точки доступа робота оставляйте Lax.
RC_COOKIE_SAMESITE=Lax

# Блокировка после неудачных попыток входа
RC_MAX_FAILED_ATTEMPTS=5
RC_LOCKOUT_SECONDS=300

# --- Учётка оператора (создаётся автоматически при установке) ---
# По умолчанию admin / 1234.
# ВАЖНО: эти две переменные действуют ТОЛЬКО при первом создании учётки
# (когда файла data/operators.json ещё нет). Смена пароля здесь НЕ меняет
# существующую учётку — вход продолжит отвергать новый пароль!
# Сменить пароль существующей учётки:
#   .venv/bin/python scripts/create_operator.py --username admin --min-length 4
RC_OPERATOR=admin
RC_OPERATOR_PASSWORD=1234

# --- Интерфейс робота RUS SLAM ---
# master — четыре Arduino Mega по I2C и адресное руление/тяга через USB-мастер.
# Можно закрепить: sim | serial | ros | auto.
RC_SLAM_SOURCE=master
# UART-порты модулей через запятую (для RC_SLAM_SOURCE=serial).
# Их же можно закрепить, чтобы лидар не перебирал порты модулей (см. RC_LIDAR_PORT).
# Пока порт не подтвердился кадрами телеметрии, источник шасси и лидар читают его
# по очереди — замок общий (data/lidar-<порт>.lock), поэтому один USB-порт не
# читают два процесса сразу.
RC_SLAM_PORTS=
# UART мастера шаговых рулевых моторов (для RC_SLAM_SOURCE=master)
RC_SLAM_PORT=/dev/ttyACM0
# Порт мастера открывает только бортовой экран (8090): один процесс на UART.
# Пульт (8080) берёт телеметрию с экрана по HTTP. Адрес по умолчанию — порт RC_KIOSK_PORT;
# переопределите, только если экран на другом адресе.
# RC_SLAM_PEER_URL=http://127.0.0.1:8090/api/kiosk_state
# PIN открытия кейса в киоске; также ячейки хранения/руления инженерного веб-пульта.
RC_SLAM_PIN=7232
RC_SLAM_LOCK_FILE=data/lock.json
RC_SLAM_MAX_ATTEMPTS=5
RC_SLAM_LOCK_SEC=30

# --- Лидар 360° (карта на основном экране и на бортовом экране) ---
# Откуда берётся скан:
#   auto   — ROS 2, если он есть в системе, иначе USB-порт (по умолчанию);
#   ros    — только ROS 2: драйвер пакета (hls_lfcd_lds_driver, rplidar_ros,
#            ldlidar_stl_ros2, turtlebot3_node) публикует sensor_msgs/LaserScan
#            в топик ниже, а приложение подписывается на него и USB-порт не открывает;
#   serial — только USB-порт читает само приложение (стенд без ROS 2, отладка).
# ROS 2-путь — рекомендуемый: порт занимает драйвер производителя, а не подбор
# портов внутри приложения. ROS 2, драйверы и ros2_ws докачиваются и
# компилируются САМИ при запуске ярлыком «Запустить робот»; вручную — так же:
#   ./scripts/ros2_setup.sh && ./scripts/ros2_lidar.sh
# (ход установки: ./scripts/ros2_setup.sh --status, журнал var/ros2_setup.log)
RC_LIDAR_SOURCE=auto
# Топик скана: сюда публикует драйвер ROS 2, отсюда читает приложение.
RC_LIDAR_ROS_TOPIC=/scan
# Топик состояния супервизора драйвера (пакет zapret_lidar, JSON): виден в
# GET /api/lidar → ros.supervisor и в панели «Лидар» обоих экранов.
# RC_LIDAR_ROS_STATUS_TOPIC=/zapret/lidar/status
# Префикс ROS 2, если он не в /opt/ros/<дистрибутив> (например распакован вручную).
# RC_ROS_PREFIX=/opt/ros/humble
# Автоустановка ROS 2 ярлыком и ros2_lidar.sh: 0 — не ставить и не компилировать
# самим (установщик пишет это при --no-ros2).
# RC_ROS_AUTO=1
# Какие драйверы лидаров ставить/компилировать (по умолчанию — этот набор;
# sllidar_ros2 — по запросу, turtlebot3_node из исходников — при модели opencr):
# RC_ROS_DRIVERS=hls_lfcd_lds_driver rplidar_ros ldlidar_stl_ros2 turtlebot3_node
# Сборка самого ROS 2 из исходников, где нет готовых пакетов (Debian, Raspberry
# Pi OS, не-LTS Ubuntu): auto | 0 (никогда) | 1 (всегда).
# RC_ROS_SOURCE_BUILD=auto
# Потоков компилятора для colcon (по умолчанию — по свободной памяти, ~1.5 ГБ на поток).
# RC_ROS_BUILD_JOBS=2
# Зеркало репозитория ROS 2 вместо http://packages.ros.org/ros2/ubuntu.
# RC_ROS_APT_MIRROR=
# Эти же настройки меняет кнопка «Лидар» в веб-пульте или «Настройки» на
# бортовом экране: они пишут сюда RC_LIDAR_* и применяют их без перезапуска, а второй процесс
# (пульт 8080 ↔ борт 8090) подхватывает файл по изменению. Руками править тоже можно.
# Порт лидара. Пусто — поиск сам: /dev/rplidar*, /dev/serial/by-id/*lidar*,
# затем все /dev/serial/by-id/*, /dev/ttyUSB*, /dev/ttyACM* (порты мастера и
# модулей шасси исключаются). Порт отсюда — только ПЕРВЫЙ в очереди: перебор
# всё равно проходит все USB-порты, поэтому переподключение лидара на другой
# /dev/ttyUSBx не оставляет экран без скана.
# Можно список через запятую и glob: /dev/ttyUSB1,/dev/ttyUSB3 или /dev/serial/by-id/*lidar*
RC_LIDAR_PORT=
# Скорость порта. Пусто — подбор: RPLIDAR A1/A2M8 — 115200, A2M7/A2M12/A3/S1 —
# 256000, C1 — 460800, LD06/LD19 и LDS-01/LDS-02 — 230400. У RPLIDAR A3 на
# USB-адаптере есть переключатель 115200/256000 — он должен совпадать со скоростью.
RC_LIDAR_BAUD=
# Модель лидара — она же протокол для USB-пути: auto | rplidar | ld06 | lds01.
# USB-путь: auto проверяет все (RPLIDAR опрашивается командой SCAN, LD06/LD19 и
# LDS-01 сыплют пакеты сами). lds01 — это лидар TurtleBot3 Burger (LDS-01, он же
# HLS-LFCD2): кадры 0xFA по 42 байта на 230400. Понимаются и синонимы: lds-01,
# hls-lfcd2, turtlebot3.
# ROS 2-путь: эта же настройка выбирает драйвер супервизора — auto подбирает
# пакет сам (проверяет кадры на порту), а rplidar/ld06/lds01/turtlebot3 запускают
# соответствующий (rplidar_ros, ldlidar_stl_ros2, hls_lfcd_lds_driver,
# turtlebot3_node — лидар через плату OpenCR).
RC_LIDAR_PROTOCOL=auto
# Включение мотора RPLIDAR через линии USB-переходника (MOTOCTL):
# auto — перебрать варианты, none — линии не трогать (у многих клонов мотор
# питается постоянно), либо жёстко: dtr-low | dtr-high | rts-low | rts-high.
# У адаптеров A1/A2 мотор включает DTR в низком уровне.
RC_LIDAR_MOTOR=auto
# 1 — сразу перебирать все /dev/ttyUSB* и /dev/ttyACM* (медленнее, но найдёт сам);
# 0 — сначала только порт из RC_LIDAR_PORT и именованные symlink'и, а если там
# данных нет, следующий круг всё равно проходит все USB-порты: закреплённый
# порт — первый в очереди, а не единственный.
RC_LIDAR_AUTOPROBE=1
# 1 — поднимать лидар сразу при старте приложения (скан появляется на экране в
# первые секунды); 0 — самому порт не открывать: скан берётся у второго процесса
# робота по HTTP (см. RC_LIDAR_PEER_URLS).
RC_LIDAR_AUTOSTART=1
# Сколько секунд источник данных шасси не занимает USB-порты своей проверкой,
# пока лидар ищет свой. Иначе на роботе с двумя адаптерами оба перебора
# сталкиваются, и лидар пишет «все порты заняты другой программой» про порты,
# которые держит это же приложение. Окно ограничено: лидара на роботе может не
# быть вовсе, и бесконечная уступка оставила бы экраны без телеметрии модулей.
# 0 — не уступать (модули проверяют порты всегда, лидар ждёт между их кругами).
RC_LIDAR_PRIORITY_S=20
# Откуда брать скан, если порт держит второй процесс робота (пульт 8080 или
# бортовой экран 8090). Собственный адрес приложения из списка исключается.
# RC_LIDAR_PEER_URLS=http://127.0.0.1:8090/api/lidar,http://127.0.0.1:8080/api/lidar
# Порты, которые лидару трогать нельзя (через запятую) — кроме мастера и модулей.
# RC_LIDAR_EXCLUDE=/dev/ttyUSB5
# Где лидар стоит физически, программа знать не может: она видит только
# USB-порт, а по /dev/serial/by-path/… — разъём или хаб. Соответствие
# «разъём → место на роботе» пишет человек; строка показывается на экране
# «Лидар не готов» в блоке «Порты на роботе».
# RC_LIDAR_PLACE_NOTE=usb-0:1.3 — хаб под крышкой, лидар на мачте; usb-0:1.1 — мастер руля
#
# Все четыре настройки ниже (порт, протокол, скорость, мотор) заполняет сама
# проверка — она же пишет постоянный путь /dev/serial/by-id/… и не трогает
# остальные строки файла:
#   .venv/bin/python scripts/lidar_check.py --save-env
# Проверить ROS 2-путь (дистрибутив, rclpy, пакеты драйверов) и убедиться, что
# скан дошёл до обоих экранов:
#   .venv/bin/python scripts/lidar_check.py --ros
#   .venv/bin/python scripts/lidar_web_check.py
# Статус драйвера ROS 2 прямо на роботе:
#   ./scripts/ros2_lidar.sh --status

# --- Аккумулятор JBD BMS: страница «Аккумулятор» бортового экрана ---
# Проще всего задать с экрана без PIN: нажать на панель АКБ → «Подключение BMS» →
# выбрать порт → «Проверить» → «Сохранить и подключить» — строка ниже запишется
# сама и опрос начнётся без перезапуска.
# Вручную: один конкретный USB-UART порт JBD, 9600 8N1. Пусто — чтение выключено.
# Рекомендуется постоянный путь /dev/serial/by-id/… (без glob/списков).
# Например: RC_BMS_PORT=/dev/serial/by-id/usb-ВАШ_АДАПТЕР_BMS
# Не должен совпадать с портом Arduino/лидара. UART читает только сервер 8090;
# пульт 8080 получает снимок через него. После правки руками перезапустить оба.
# Настройка BMS, все банки и CSV-отчёт доступны без PIN. Подробности: docs/battery.md.
RC_BMS_PORT=

# --- Бортовой экран робота (киоск) ---
# Порт экрана (пульт оператора занимает 8080).
RC_KIOSK_PORT=8090
# Открывать экран в браузере в киоск-режиме. Пусто/не задано — открывать,
# если есть графическая сессия (DISPLAY/WAYLAND_DISPLAY). 0 — только сервер.
RC_KIOSK_OPEN=
# Снова открывать экран, если браузер закрыли (1 — да, по умолчанию).
RC_KIOSK_WATCHDOG=1
# Какой браузер запускать (по умолчанию — первый найденный из chromium/chrome/firefox).
RC_KIOSK_BROWSER=
# Сколько записей настоящего журнала держать в памяти для панели «Логи»
# на бортовом экране (GET /api/kiosk_logs). 20…5000, по умолчанию 400.
RC_KIOSK_LOG_LIMIT=400
# Отдельный профиль киоска. Пусто — ~/.cache/robot-kiosk-browser.
# Snap Firefox этот скрытый путь не читает и показывает
# «Your Firefox profile cannot be loaded»; запуск сам перенесёт профиль
# в ~/snap/firefox/common/robot-kiosk-browser. Свой путь сработает, только
# если он не скрытый и лежит в домашнем каталоге (или уже в ~/snap/<имя>/).
# RC_KIOSK_PROFILE_DIR=

# --- Автозапуск ---
# Переменных окружения здесь нет: автозапуск приложения (службы systemd,
# ярлык сеанса, автоподъём точки доступа) включается и выключается командами
#   ./scripts/autostart.sh status   # что стартует само (по умолчанию)
#   ./scripts/autostart.sh off      # выключить автозапуск целиком
#   ./scripts/autostart.sh on       # вернуть автозапуск
# По умолчанию приложение само не запускается: пульт и экран поднимаются
# вручную — ./scripts/start.sh и ./scripts/kiosk.sh.
