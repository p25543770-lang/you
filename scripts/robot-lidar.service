# Лидар робота через ROS 2: супервизор драйвера (пакет zapret_lidar).
#
# Ставится командой ./scripts/ros2_setup.sh --service, она же подставляет
# фактический путь проекта и пользователя вместо /opt/robot-control и robotctl.
#
# Установка вручную:
#   sudo cp scripts/robot-lidar.service /etc/systemd/system/
#   sudo sed -i "s|/opt/robot-control|$PWD|g; s|User=robotctl|User=$USER|g; s|Group=robotctl|Group=$USER|g" \
#     /etc/systemd/system/robot-lidar.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now robot-lidar
#   journalctl -u robot-lidar -f
#
# Выключить автозапуск: sudo systemctl disable --now robot-lidar
# (./scripts/autostart.sh off тоже гасит эту службу, если она установлена).
#
[Unit]
Description=Robot lidar over ROS 2 (zapret_lidar supervisor)
# Лидар поднимается ДО приложений: тогда пульт и бортовой экран сразу читают
# /scan, а USB-порт занимает драйвер, а не подбор портов внутри приложения.
Before=robot-control.service robot-kiosk.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robotctl
Group=robotctl
# USB-порт лидара (/dev/ttyUSB*) доступен только группе dialout.
SupplementaryGroups=dialout
WorkingDirectory=/opt/robot-control
EnvironmentFile=-/opt/robot-control/.env
# Скрипт сам выполняет source /opt/ros/<дистрибутив>/setup.bash и запускает
# супервизор; модель и порт берутся из .env (RC_LIDAR_PROTOCOL/RC_LIDAR_PORT).
ExecStart=/opt/robot-control/scripts/ros2_lidar.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/robot-control

[Install]
WantedBy=multi-user.target
