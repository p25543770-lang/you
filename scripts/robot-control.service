# Запуск веб-пульта как службы Ubuntu (автозапуск — по желанию: без
# `systemctl enable` служба просто стоит на месте, а пульт запускается
# вручную — ./scripts/start.sh).
#
# Установка:
#   sudo useradd --system --home /opt/robot-control --shell /usr/sbin/nologin robotctl || true
#   sudo mkdir -p /opt/robot-control && sudo cp -r . /opt/robot-control
#   sudo chown -R robotctl:robotctl /opt/robot-control
#   sudo cp scripts/robot-control.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now robot-control
#   journalctl -u robot-control -f
#
# Выключить автозапуск:  ./scripts/autostart.sh off  (или sudo systemctl disable --now robot-control)
#
[Unit]
Description=Robot control web console (operator login)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=robotctl
Group=robotctl
# USB-лидар и UART-модули живут в /dev/ttyUSB*: без группы dialout служба
# получает «Permission denied», и карта лидара остаётся пустой.
SupplementaryGroups=dialout
WorkingDirectory=/opt/robot-control
EnvironmentFile=/opt/robot-control/.env
# Строго python из .venv проекта: в нём Flask и pyserial (см. ensure_deps.sh).
# Системный /usr/bin/python3 их не имеет — лидар не читался бы вовсе, хотя
# scripts/lidar_check.py, запущенный из .venv, находил устройство.
ExecStart=/opt/robot-control/.venv/bin/python /opt/robot-control/run.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/robot-control/data /opt/robot-control/var

[Install]
WantedBy=multi-user.target
